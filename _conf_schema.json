{
  "enable_ai_command_notify": {
    "description": "AI执行命令前通知",
    "type": "bool",
    "default": true,
    "hint": "开启后，AI调用 execute_astrbot_command 前会发送'正在执行命令: <command>'通知"
  },
  "enable_ai_command_result": {
    "description": "AI执行命令结果通知",
    "type": "bool",
    "default": true,
    "hint": "开启后，AI执行命令结束会发送成功/失败结果提示"
  },
  "ai_command_blacklist": {
    "description": "AI命令调用黑名单",
    "type": "list",
    "default": [
      "astrbot",
      "astrbot-web-searcher",
      "astrbot-python-interpreter",
      "session_controller",
      "builtin_commands",
      "astrbot-reminder"
    ],
    "hint": "禁止AI通过 execute_astrbot_command 调用的插件列表，用于预防AI绕过权限或调用敏感命令"
  },
  "ignored_plugins": {
    "description": "黑名单插件 ID",
    "type": "list",
    "default": [
      "astrbot",
      "astrbot-web-searcher",
      "astrbot-python-interpreter",
      "session_controller",
      "builtin_commands",
      "astrbot-reminder",
      "astrbot_plugin_help"
    ],
    "hint": "屏蔽不想展示、导致问题的插件菜单 (使用 name 字段)"
  },
  "regex": {
    "description": "正则触发器设置",
    "type": "object",
    "items": {
      "max_examples": {
        "description": "每条正则最多示例数",
        "type": "int",
        "default": 10,
        "slider": {
          "min": 1,
          "max": 20,
          "step": 1
        },
        "hint": "按从简单到复杂的顺序生成，超出上限时只保留前 N 条"
      }
    }
  },
  "rendering": {
    "description": "渲染引擎设置",
    "type": "object",
    "items": {
      "use_t2i": {
        "description": "使用 AstrBot 内置图片渲染",
        "type": "bool",
        "default": true,
        "hint": "开启后使用 AstrBot 内置的 t2i 服务渲染图片，无需安装 Playwright (推荐，性能更好)"
      },
      "html_theme": {
        "description": "HTML 主题",
        "type": "string",
        "default": "simple",
        "options": [
          "simple"
        ],
        "hint": "HTML 渲染时的主题名称，目前仅支持 simple (简约风格)"
      },
      "jpeg_quality": {
        "description": "JPEG 图片质量",
        "type": "int",
        "slider": {
          "min": 50,
          "max": 100,
          "step": 5
        },
        "default": 95,
        "hint": "HTML 渲染时 JPEG 图片的质量 (1-100)，数值越高质量越好但文件越大"
      },
      "timeout_analysis": {
        "description": "数据分析超时 (秒)",
        "type": "float",
        "slider": {
          "min": 3,
          "max": 30,
          "step": 1
        },
        "default": 10.0,
        "hint": "生成数据结构的超时时间，根据插件数量调整"
      },
      "max_concurrent_tasks": {
        "description": "最大并发渲染数",
        "type": "int",
        "slider": {
          "min": 1,
          "max": 10,
          "step": 1
        },
        "default": 2,
        "hint": "同时进行的渲染任务数量限制，根据 CPU 调整"
      },
      "giant_threshold": {
        "description": "巨型块阈值 (pt)",
        "type": "int",
        "slider": {
          "min": 100,
          "max": 3000,
          "step": 100
        },
        "default": 1500,
        "hint": "超过此高度的插件将独占一行显示 (仅 Event/Filter 模式有效)"
      },
      "render_wait_timeout": {
        "description": "渲染等待超时 (毫秒)",
        "type": "int",
        "slider": {
          "min": 5000,
          "max": 30000,
          "step": 1000
        },
        "default": 10000,
        "hint": "等待字体和图片加载的最大时间，网络较慢时可增加此值"
      },
      "render_image_timeout": {
        "description": "单张图片加载超时 (毫秒)",
        "type": "int",
        "slider": {
          "min": 1000,
          "max": 10000,
          "step": 500
        },
        "default": 5000,
        "hint": "单张图片的最大加载时间，超时后将继续渲染"
      }
    }
  }
}
